OPENAI_API_KEY=
REPRO_MODEL=gpt-5.6-luna
REPRO_REASONING_EFFORT=low
REPRO_DATA_DIR=.repro
REPRO_WORKER_IMAGE=repro-worker:local
REPRO_WORKER_PLATFORM=linux/amd64
REPRO_VALIDATION_NETWORK=false
REPRO_MAX_MODEL_CALLS=60
REPRO_MAX_OUTPUT_TOKENS=4000
REPRO_REQUEST_TIMEOUT_SECONDS=300
REPRO_MAX_SECONDS=1800
REPRO_REPETITIONS=5
